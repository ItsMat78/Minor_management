{#
  Transcribed from the live config on minor-project.iiitnr.ac.in (2026-07-27).

  This file previously described a server that did not exist: it published the API on a separate
  SSL port 3000 and had no /api proxy at all. Production has never run that way. Everything is
  single-origin on 443, which is why the client builds with an empty VITE_API_URL and talks to
  relative /api and /uploads paths. Applying the old template would have taken the portal down.

  Keep this in step with the box. If you change nginx by hand, change it here too.
#}
# HTTP: ACME challenge, everything else redirected to HTTPS
server {
    listen 80;
    server_name {{ nginx_server_name }};

    location /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: SPA, API, websocket and uploaded files all on one origin
server {
    listen 443 ssl;
    server_name {{ nginx_server_name }};

    ssl_certificate     {{ ssl_cert_file }};
    ssl_certificate_key {{ ssl_key_file }};

    root {{ client_dist }};

    # Must stay above multer's 10MB cap (server/src/middleware/uploadMiddleware.ts) so an
    # oversized file is refused by the app, which says why, rather than by nginx, whose 413 is
    # an HTML page with no CORS headers and so reaches the browser as an opaque network error.
    # The 1MB default silently rejected every photo taken on a phone.
    client_max_body_size 12m;

    # Uploaded files are served by the API off disk, not built into the SPA. Without this they
    # fall through to the try_files catch-all below and return index.html with a 200, which a
    # browser renders as a broken image rather than reporting as an error.
    location /uploads/ {
        proxy_pass         http://127.0.0.1:{{ api_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    index index.html;

    # The SPA shell must never be cached, or a deploy leaves clients on stale hashed bundles.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /socket.io/ {
        proxy_pass         http://127.0.0.1:{{ api_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /api/ {
        proxy_pass         http://127.0.0.1:{{ api_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        'upgrade';
        proxy_set_header   Host              $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
